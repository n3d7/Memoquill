# Dependencies and build output
node_modules/
/dist/
/target/
/src-tauri/target/
*.tsbuildinfo

# Tauri-generated schemas and command permissions (keep authored permissions)
/src-tauri/gen/
/src-tauri/permissions/autogenerated/

# Local verification output and agent state
/coverage/
/.metrics/
/.qualification/
/.serena/
/.codex/

# Python helpers and isolated tool environments
__pycache__/
*.py[cod]
.venv/

# Local environment values; keep a shareable example
.env
.env.*
!.env.example

# Package-manager logs and editor/OS temporary files
npm-debug.log*
*.swp
*.swo
*~
.DS_Store

# Lockfiles, project configuration, AGENTS.md and .agents/skills are versioned.
