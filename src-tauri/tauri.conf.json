{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memoquill",
  "version": "0.1.0",
  "identifier": "io.github.n3d7.memoquill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Memoquill", "width": 1120, "height": 900, "minWidth": 360, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "category": "Education",
    "shortDescription": "Local-first, subject-independent learning workspace",
    "longDescription": "Memoquill supports custom subjects, structured material authoring, managed originals and offline organization. AI and cloud services are not required.",
    "copyright": "Copyright 2026 n3d7",
    "license": "LicenseRef-Memoquill-Apache-2.0-Commons-Clause-1.0",
    "licenseFile": "../LICENSE",
    "icon": ["icons/128x128.png"],
    "resources": { "../LICENSE": "licenses/Memoquill-LICENSE.txt", "../docs/licenses/": "licenses/third-party/" },
    "linux": { "rpm": { "release": "1", "depends": ["webkit2gtk4.1", "gtk3"] } }
  }
}
