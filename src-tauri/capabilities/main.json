{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main-window typed workspace, authoring and managed-source operations; explicit native picker copies regular bounded user-selected files. No arbitrary SQL, caller-path file access, execution, network or window commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-check-draft",
    "allow-workspace-status",
    "allow-save-reading-preferences",
    "allow-operation-receipt",
    "allow-reopen-workspace",
    "allow-library",
    "dialog:allow-open",
    "allow-apply-content",
    "allow-save-document",
    "allow-read-document",
    "allow-save-annotation",
    "allow-annotations",
    "allow-save-reading-position",
    "allow-reading-position",
    "allow-pick-source",
    "allow-sources",
    "allow-save-source",
    "allow-source-preview"
  ]
}
