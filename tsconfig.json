{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "verbatimModuleSyntax": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"], "noEmit": true
  },
  "include": ["src", "vite.config.ts", "tests/fixtures"]
}
